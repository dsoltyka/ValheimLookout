<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AssemblyName>POIRadar</AssemblyName>
    <RootNamespace>POIRadar</RootNamespace>
    <Version>1.0.0</Version>
    <Description>Shows nearby points of interest on the minimap: dungeon entrances and ore deposits by default, with optional pickables and surface locations. Client-side.</Description>
    <ThunderstoreWebsite>https://github.com/dsoltyka/ValheimPOIRadar</ThunderstoreWebsite>
  </PropertyGroup>

  <ItemGroup>
    <!-- Every file under Assets/ is embedded under its bare file name, e.g. Assets\dungeon.png -> "dungeon.png". -->
    <EmbeddedResource Include="Assets\**" LogicalName="%(Filename)%(Extension)" />
  </ItemGroup>

  <!--
    Game/BepInEx/Jotunn references, deploy and Thunderstore packaging come from the shared
    ValheimModBuild repo, expected next to this one:
      https://github.com/dsoltyka/ValheimModBuild
  -->
  <PropertyGroup>
    <ValheimModBuild>$(MSBuildThisFileDirectory)..\ValheimModBuild\Valheim.Mod.props</ValheimModBuild>
  </PropertyGroup>
  <Import Project="$(ValheimModBuild)" Condition="Exists('$(ValheimModBuild)')" />
  <Target Name="RequireValheimModBuild" BeforeTargets="Build;Restore;CollectPackageReferences" Condition="!Exists('$(ValheimModBuild)')">
    <Error Text="Shared build props not found at '$(ValheimModBuild)'. Clone https://github.com/dsoltyka/ValheimModBuild next to this repo (see BUILDING.md)." />
  </Target>

</Project>
